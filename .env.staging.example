# Mẫu cấu hình môi trường Staging cô lập (KHÔNG dùng chung DB/Redis với Production)
NODE_ENV=staging
PORT=5055

# 1. MongoDB Staging độc lập (bắt buộc tên DB kết thúc bằng _staging; dùng tài khoản chỉ có quyền readWrite trên DB Staging)
ENFORCE_STAGING_DB_ISOLATION=1
STAGING_MONGO_ROOT_USER=staging_root_admin
STAGING_MONGO_ROOT_PASSWORD=StagingRootAuth_2026_Secure
STAGING_MONGO_APP_USER=dewskill_staging_app
STAGING_MONGO_APP_PASSWORD=StagingAppAuth_2026_Secure
STAGING_MONGODB_URI=mongodb://dewskill_staging_app:StagingAppAuth_2026_Secure@127.0.0.1:27018/dashboardthangtinhoc_staging?authSource=dashboardthangtinhoc_staging
MONGODB_URI=mongodb://dewskill_staging_app:StagingAppAuth_2026_Secure@127.0.0.1:27018/dashboardthangtinhoc_staging?authSource=dashboardthangtinhoc_staging

# 2. Redis 7.x riêng biệt (cổng nội bộ 6380 + requirepass + AOF + DB index /1 + prefix cms:staging: tách tuyệt đối khỏi Production cms:prod:)
ENABLE_REDIS=true
STAGING_REDIS_PASSWORD=StagingRedisAuth_2026_Secure
STAGING_REDIS_URL=redis://:StagingRedisAuth_2026_Secure@127.0.0.1:6380/1
REDIS_URL=redis://:StagingRedisAuth_2026_Secure@127.0.0.1:6380/1
REDIS_KEY_PREFIX=cms:staging:

# 3. Khóa bảo mật riêng cho Staging (KHÔNG tái sử dụng secret Production)
STAGING_JWT_SECRET=replace-with-unique-staging-jwt-secret-min-32-chars
STAGING_JWT_REFRESH_SECRET=replace-with-unique-staging-refresh-secret-min-32-chars
STAGING_SESSION_SECRET=replace-with-unique-staging-session-secret-min-32-chars
STAGING_CLIENT_URL=http://localhost:5174
AI_SUPPORT_ENABLED=1
MOBILE_MULTI_SESSION_AUTH=true

# 4. Cấu hình AI RAG Canary có kiểm soát (CHỈ bật cho danh sách User ID thử nghiệm)
AI_KNOWLEDGE_RAG_ENABLED=1
AI_KNOWLEDGE_VECTOR_ENABLED=0
AI_KNOWLEDGE_RAG_CANARY_USER_IDS=690000000000000000000101,690000000000000000000102,690000000000000000000103,690000000000000000000104
AI_KNOWLEDGE_RAG_ALLOW_ROLE_EXPANSION=0
AI_KNOWLEDGE_RAG_ALLOW_ALL_PRODUCTION=0
AI_QUICK_ASK_TELEMETRY_LOG=1
AI_QUICK_ASK_CACHE_TTL_SEC=1800

# 5. Gemini API Key (điền key trên server triển khai, KHÔNG commit lên Git)
GEMINI_API_KEY=
GEMINI_API_KEYS=
