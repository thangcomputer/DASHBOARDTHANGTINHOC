# Set this to the backend origin (do not append /api).
# Expo web dev defaults to http://localhost:5000 when this is empty.
# Native devices and production builds must set a reachable backend URL.
# Android emulator: http://10.0.2.2:5000 (matches the backend PORT in .env)
# iOS simulator: http://localhost:5000
# Physical device: use the backend host's reachable LAN/HTTPS URL on port 5000.
EXPO_PUBLIC_MOBILE_API_BASE_URL=

# Set the EAS project ID after linking this app with `eas init`.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Configure these only with canonical, owner-approved HTTPS URLs.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=
EXPO_PUBLIC_SUPPORT_URL=

# Optional web app origin for the static default logo when no custom logo is set.
EXPO_PUBLIC_WEB_BASE_URL=

# Real native login uses the same phone/password as the Web account.
# Enable MOBILE_MULTI_SESSION_AUTH=true in the backend .env; keep the server default OFF.
