# Copy values into the shell running Phase 1.5 tests. Do not rename this file to
# .env: server.js deliberately does not load dotenv when NODE_ENV=test.
NODE_ENV=test
TEST_DATABASE_URI=mongodb://127.0.0.1:27019/dashboardthangtinhoc_phase15_test
ALLOW_TEST_DB_RESET=true

# Set true only after confirming the test and runtime hosts are intentionally
# the same host but use isolated Mongo instances/databases.
ALLOW_TEST_DB_HOST_MATCH=false

PORT=5095
CLIENT_URL=http://127.0.0.1:5095
JWT_SECRET=phase15-test-jwt-secret-change-me
JWT_REFRESH_SECRET=phase15-test-refresh-secret-change-me
MASTER_ADMIN_PHONE=0900000001
MASTER_ADMIN_PASSWORD=phase15-test-master-password
RUN_OUTBOX_WORKER=0
BACKUP_SCHEDULE=0
ENABLE_REDIS=false
