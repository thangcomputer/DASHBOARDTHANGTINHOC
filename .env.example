# Copy to .env and fill in values. Never commit .env.

NODE_ENV=development
PORT=5000
# CQRS multi-doc transactions cần replica set. Docker Compose đã bật rs0:
# MONGODB_URI=mongodb://127.0.0.1:27017/dashboardthangtinhoc?replicaSet=rs0
# Standalone (không CQRS): bỏ ?replicaSet=
MONGODB_URI=mongodb://127.0.0.1:27017/dashboardthangtinhoc

# ─── CQRS strangler flags (Phase A) ──────────────────────────────────────────
# false = dùng legacy LIVE (khuyến nghị cho messaging deploy).
# CẢNH BÁO: trên origin/main (CQRS-only cutover), false + requireStudentCreateCqrs HARD
# sẽ 503 "Luồng tạo HV cũ đã tắt". Deploy nhánh có legacy fallback, hoặc soft middleware,
# hoặc bật true khi Mongo đã ?replicaSet= / mongodb+srv.
ENABLE_CQRS_STUDENT_CREATE=false
ENABLE_CQRS_INVOICE=false
ENABLE_CQRS_TEACHER=false
ENABLE_CQRS_FINANCE=false
# Phase 7.1 cutover toggle — template default OFF for new environments.
# Production may activate a single family (e.g. backups) only via explicit Phase 7.4+ authorization.
POLICY_CUTOVER_ENABLED=false
POLICY_CUTOVER_ROUTES=
# Phase 8.11 — Enterprise RBAC dual-read OBSERVE only (default OFF). Never authorizes.
# When true: compare LIVE vs Enterprise after checkPermission; LIVE remains sole authority.
RBAC_PARITY_OBSERVE_ENABLED=false
# Phase 8.12 — Enterprise RBAC dual-check SHADOW only (default OFF). Never authorizes.
RBAC_DUAL_CHECK_ENABLED=false
# Phase 8.13 — Intentional soak window marker (default OFF). Required for SOAK_EVIDENCE=AVAILABLE.
# Never enable in unit/integration tests. Staging/prod soak only, alongside OBSERVE+DUAL_CHECK.
RBAC_SOAK_WINDOW_ACTIVE=false
# Phase 8.20C — optional shared token for GET /internal/rbac/runtime-evidence (loopback still required)
# RBAC_RUNTIME_EVIDENCE_TOKEN=
# RBAC_RUNTIME_EVIDENCE_URL=http://127.0.0.1:5000/internal/rbac/runtime-evidence
# Phase 8.17 — Soak environment guard (LOCAL|STAGING|PRODUCTION). Default LOCAL = not production-eligible.
RBAC_SOAK_ENVIRONMENT=LOCAL
# Phase 8.17 — Controlled soak window length (seconds). Required for production orchestrator. Max 86400.
# SOAK_DURATION_SECONDS=300
# Phase 8.18 — Minimum RUNTIME hook events required for PRODUCTION_SOAK_EVIDENCE=AVAILABLE (default 10).
# RBAC_SOAK_MIN_RUNTIME_EVENTS=10
# Phase 8.13/8.17 — Soak: enable OBSERVE + DUAL_CHECK only via env (never hardcode true).
# Production soak evidence requires STAGING|PRODUCTION + all three flags + RUNTIME observations.
# Orchestrator: node scripts/rbac-soak-production.cjs (does not auto-enable flags; ENTERPRISE_PRIMARY stays NO).
# Phase 8.18 evaluator: services/rbacParity/runtimeSoakEvidence.js — LOCAL/SYNTHETIC/STATIC never count.
# Phase 8.20 RUNTIME evidence pipeline: services/rbacParity/runtimeEvidence820.js
# Artifact: artifacts/rbac-runtime-evidence-820.json — AVAILABLE only with STAGING|PRODUCTION + flags + RUNTIME events>0.
# Phase 8.20 never auto-enables flags and never sets ENTERPRISE_PRIMARY_READY=YES.
# Production: CQRS=true is rejected at startup unless this explicit opt-in is set:
# ALLOW_CQRS_IN_PRODUCTION=false
#
# Outbox dispatcher (domain events). Single API: để trống hoặc 1.
# Multi-API / docker compose: API=0, worker=1
# RUN_OUTBOX_WORKER=1
# OUTBOX_POLL_MS=5000
# OUTBOX_LEASE_MS=60000

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

CLIENT_URL=http://localhost:5173
FRONTEND_URL=

# Cookie signing (OAuth state). Defaults to JWT_SECRET if unset.
COOKIE_SECRET=

# Behind Nginx / Cloudflare: TRUST_PROXY=1
TRUST_PROXY=1

# JSON body limit (use Multer for large files)
JSON_BODY_LIMIT=1mb

# Tin nháº¯n: file/áº£nh Ä‘Ã­nh kÃ¨m tá»± xÃ³a sau N ngÃ y (máº·c Ä‘á»‹nh 10)
MESSAGE_FILE_RETENTION_DAYS=10

# Optional: Redis — token blacklist + query cache + BullMQ job queue
# Không đặt = in-memory cache + queue inline (dev đơn instance vẫn chạy bình thường)
# REDIS_URL=redis://127.0.0.1:6379

# Zalo OA — gửi OTP / mật khẩu (queue job notify)
# ZALO_OA_TOKEN=
# ZALO_OA_REFRESH_TOKEN=

# AI Center (Phase 11) — OpenAI-compatible (OpenAI / Gemini / Ollama...)
# AI_ENABLED=1
#
# Cach 1 — Gemini mien phi (Google AI Studio: https://aistudio.google.com/apikey)
# Mot key:
# GEMINI_API_KEY=your_key_here
# Nhieu key (project/tai khoan khac nhau) — failover khi 429:
# GEMINI_API_KEYS=key1,key2,key3,key4
# GEMINI_KEY_COOLDOWN_MS=60000
# AI_MODEL=gemini-3.6-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#
# Cach 2 — OpenAI hoac tuong thich
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=45000
#
# Trợ lý AI chat hỗ trợ (HV/GV) — tách khỏi luồng tin nhắn thường
# AI_SUPPORT_ENABLED=1
# Idle: 5 phút không hỏi → "còn đó không"; thêm 5 phút không trả lời → hết phiên
# AI_SUPPORT_IDLE_PING_MS=300000
# AI_SUPPORT_IDLE_END_MS=300000
# HV: 15 câu Gemini / ngày; GV: 25. FAQ sẵn không trừ lượt.
# AI_SUPPORT_QUESTION_DAILY_LIMIT_STUDENT=15
# AI_SUPPORT_QUESTION_DAILY_LIMIT_TEACHER=25
# Ảnh gửi AI: tối đa 5 / ngày
# AI_SUPPORT_IMAGE_DAILY_LIMIT=5

# Backup (Phase 9) — Super Admin only
# BACKUP_KEEP=7
# BACKUP_SCHEDULE=1
# BACKUP_CRON=0 3 * * *

# SMTP — gửi OTP / mật khẩu / hóa đơn PDF (queue job notify)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Thang Tin Hoc <noreply@example.com>"

# Optional: encrypt session payloads stored in Mongo (production only)
# SESSION_ENCRYPTION_KEY=

# Rate limits (production). Dashboard admin gọi nhiều API — đừng để thấp (vd. 400).
# RATE_LIMIT_API_MAX=20000
# RATE_LIMIT_API_ANON_MAX=300
# RATE_LIMIT_LOGIN_MAX=25
# RATE_LIMIT_CAPTCHA_MAX=120
# RATE_LIMIT_REFRESH_MAX=200
# RATE_LIMIT_SENSITIVE_MAX=20
# RATE_LIMIT_CHECK_ROLE_MAX=60

# Social login is disabled. Google/Zalo OAuth endpoints return HTTP 410.

# SePay webhook (required in production — fail-closed if unset)
SEPAY_API_KEY=
SEPAY_SECRET_KEY=

# Finance Ledger SoT (P4). Default ON if unset.
# FINANCE_LEDGER_SOT=true
# Allow hard-delete Invoice/Transaction / wipe finance (dev only; required for production wipe)
# FINANCE_ALLOW_HARD_DELETE=false

# Bank display / QR
BANK_ID=
ACCOUNT_NO=
ACCOUNT_NAME=

LOG_LEVEL=info

# Deploy helper (deploy_scripts/set_zalo_token.cjs â€” never commit secrets)
# DEPLOY_SSH_HOST=
# DEPLOY_SSH_USER=root
# DEPLOY_SSH_PASSWORD=
# DEPLOY_ENV_FILE=/www/wwwroot/dashboardthangtinhoc/.env

# Super Admin signs in with this phone; no default and no literal "admin" login.
MASTER_ADMIN_PHONE=0935758462
# Password fallback when adminPasswordHash is not set in DB.
MASTER_ADMIN_PASSWORD=admin123

# Super Admin MFA (TOTP): bật qua API sau khi đăng nhập
# POST /api/auth/mfa/setup → POST /api/auth/mfa/enable { code }
# Tắt: POST /api/auth/mfa/disable { password, code }
# VPS deploy scripts (rebuild_frontend.cjs, sync_vps.cjs) — never commit real values
# VPS_HOST=
# VPS_USER=root
# VPS_PASSWORD=
# VPS_SSH_KEY_PATH=
# VPS_APP_DIR=/www/wwwroot/dashboard-thangtinhoc-edu-vn
